{
  "DatabaseProvider": "PostgreSQL",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=5432;Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "VTOS.API",
    "Audience": "VTOS.Client",
    "ExpiryMinutes": 60
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "${EMAIL_USERNAME}",
    "Password": "${EMAIL_PASSWORD}",
    "FromEmail": "noreply@vtos.com",
    "FromName": "VTOS System",
    "EnableSsl": true
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "${FRONTEND_URL}"
    ]
  },
  "FrontendSettings": {
    "BaseUrl": "${FRONTEND_URL}"
  },
  "TryOnSettings": {
    "ApiKey": "${TRYON_API_KEY}",
    "ApiUrl": "https://api.302.ai/302/submit/virtual-tryon-v2",
    "MaxGuestTriesPerSession": 3
  },
  "ImageStorage": {
    "Minio": {
      "Endpoint": "media.vtos.homes",
      "AccessKey": "admin",
      "SecretKey": "Camthao5*",
      "BucketName": "media",
      "UseSSL": true,
      "PublicBaseUrl": "https://media.vtos.homes"
    }
  },
  "PayOSSettings": {
    "ClientId": "${PAYOS_CLIENT_ID}",
    "ApiKey": "${PAYOS_API_KEY}",
    "ChecksumKey": "${PAYOS_CHECKSUM_KEY}",
    "PaymentApiPrefix": "v2/payment-requests",
    "PayoutClientId": "${PAYOS_PAYOUT_CLIENT_ID}",
    "PayoutApiKey": "${PAYOS_PAYOUT_API_KEY}",
    "PayoutChecksumKey": "${PAYOS_PAYOUT_CHECKSUM_KEY}",
    "PayoutApiPrefix": "v1/payouts",
    "ApiUrl": "https://api-merchant.payos.vn"
  },
  "PaymentSettings": {
    "ReturnBaseUrl": "${FRONTEND_URL}",
    "ReturnSuccessPath": "/payment/success",
    "ReturnCancelPath": "/payment/cancel"
  },
  "GoogleAuth": {
    "ClientId": "${GOOGLE_CLIENT_ID}"
  }
}
